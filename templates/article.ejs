
<%
  /*  Images en habillage : articles pairs → image à gauche,
      articles impairs → image à droite                            */
  const floatClass = (typeof index !== 'undefined' && index % 2 === 1)
    ? 'text-wrap-right'
    : 'text-wrap-left';
%>

<div class="article">
  <h2 class="article-title"><%= article.title %></h2>

  <% if (article.img) { 
    // Convertir les URLs localhost en chemins relatifs pour l'impression
    let articleImgSrc = article.img;
    if (articleImgSrc.includes('localhost:') || articleImgSrc.startsWith('http://localhost') || articleImgSrc.startsWith('https://localhost')) {
      articleImgSrc = articleImgSrc.replace(/^https?:\/\/localhost:\d+/, '.');
    }
  %>
    <img src="<%= articleImgSrc %>" alt="<%= article.alt %>" class="article-image <%= floatClass %>">
  <% } %>

  <div class="article-text">
    <%- article.content %>
  </div>

  <!-- Remet le flux normal après l’image flottante -->
  <div class="clear"></div>
</div>