# Port du serveur (optionnel, défaut: 3000)
PORT=3000

# ===== CHEMINS OBLIGATOIRES =====
# Dossier contenant les articles Markdown
ARTICLES_DIR=

# Chemin vers le fichier JSON des événements
EVENTS_PATH=

# ===== CHEMINS OPTIONNELS =====
# Préfixe pour les URLs des images (ex: https://www.breux-sur-avre.fr/)
IMAGES_PATH=

# Image principale pour la couverture
MAIN_IMAGE=

# Dossier des templates EJS (défaut: ./templates)
TEMPLATE_DIR=./templates

# Nom du template principal (défaut: breves-template.ejs)
TEMPLATE_NAME=breves-template.ejs

# Fichier de sortie généré (défaut: ./breves.html)
OUTPUT_FILE=./breves.html

# ===== DATES PAR DÉFAUT (optionnel) =====
# Format: MM-DD-YYYY
# Si non défini, START_DATE = 6 mois avant aujourd'hui, END_DATE = aujourd'hui
# START_DATE=01-01-2025
# END_DATE=06-30-2025

# ===== CONTENU PAR DÉFAUT (optionnel) =====
# Message du maire par défaut
# MAYOR_MESSAGE=Message du maire...
